# ============================================
# Vivado Project .gitignore
# ============================================

# --- Vivado 產生的快取與暫存資料夾 ---
.cache/
.hw/
.ip_user_files/
.runs/
.sim/
.gen/
*.cache/
*.hw/
*.runs/
*.sim/
*.gen/
*.ip_user_files/

# --- IP 產生檔（保留 .xci，忽略輸出）---
*/ip/*/*_sim_netlist.v
*/ip/*/*_sim_netlist.vhdl
*/ip/*/*_stub.v
*/ip/*/*_stub.vhdl
*/ip/*/hdl/
*/ip/*/impl/
*/ip/*/simulation/
*/ip/*/synth/

# --- Log 與 Journal ---
*.log
*.jou
*.str
*.debug

# --- Bitstream 與燒錄檔 ---
*.bit
*.bin
*.mcs
*.prm
*.ltx

# --- 報告檔（可重新產生）---
*.rpt
*.pb
*.xsa

# --- Vivado 備份檔 ---
*.xpr.bak
*.bak
*_backup/

# --- Webtalk ---
webtalk/
webtalk_*.xml

# --- 系統與編輯器雜項 ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/